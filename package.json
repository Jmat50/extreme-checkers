{
  "name": "extreme-checkers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build:gh": "cross-env BASE_PATH=/extreme-checkers/ npm run build",
    "verify:gh": "node scripts/verify-gh-pages.mjs",
    "test:gh": "npm run build:gh && npm run verify:gh",
    "editor": "concurrently -k \"cross-env VITE_EDITOR_MODE=true vite\" \"wait-on http://localhost:5173/editor.html && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:editor:win": "cross-env VITE_EDITOR_MODE=true vite build --base ./ && electron-builder --win portable"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "koa": "^2.15.3",
    "koa-body": "^8.0.0",
    "node-persist": "^4.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "leva": "^0.10.0",
    "sharp": "^0.35.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.extremecheckers.editor",
    "productName": "Extreme Checkers Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/assets/**/*",
      "dist/icons/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    }
  }
}
